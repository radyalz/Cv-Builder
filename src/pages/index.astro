---
import Base from "../layouts/Base.astro";
import BuilderCard from "../components/page/BuilderCard.astro";
import FormsMenu from "../components/page/FormsMenu.astro";
import IntroPop from "../components/page/IntroPop.astro";
import Tour from "../components/page/Tour.astro";
import ColourMenu from "../components/ColourMenu.astro";
---

<Base
  title="Radman Alizadeh — CV Builder"
  description="Generate and download the latest version of Radman Alizadeh's CV."
>
  <BuilderCard />

  <FormsMenu slot="overlays" />
  <IntroPop slot="overlays" />
  <Tour slot="overlays" />
  <ColourMenu slot="overlays" />
</Base>

<script>
  import { initBuilder } from "../scripts/builder";
  import { initFormsMenu } from "../scripts/forms-menu";
  import { initMorph } from "../scripts/morph";
  import { initIntroInfo } from "../scripts/intro-info";

  initBuilder();
  initFormsMenu();
  initMorph();
  initIntroInfo();
</script>
