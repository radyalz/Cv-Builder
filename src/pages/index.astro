---
import Base from "../layouts/Base.astro";
import Segmented from "../components/Segmented.astro";
import PreviewPane from "../components/PreviewPane.astro";
import ColourMenu from "../components/ColourMenu.astro";
import ActionBar from "../components/ActionBar.astro";
import { STRINGS } from "../lib/data";

const en = STRINGS.en;
---

<Base
  title="Radman Alizadeh — CV Builder"
  description="Generate and download the latest version of Radman Alizadeh's CV."
>
  <section class="builder-card" aria-labelledby="page-title" transition:name="card">
    <div class="card-main">
      <div class="card-top">
        <div class="eyebrow" data-i18n="eyebrow">{en.eyebrow}</div>
      </div>

      <div class="title-row">
        <h1 id="page-title" data-i18n="name">{en.name}</h1>

        <!-- "How it works": the intro for the controls on screen and the
             tour of them (src/scripts/intro-info.js). -->
        <button
          id="introInfo"
          class="intro-info"
          type="button"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="introPop"
          aria-label={en.howItWorks}
          data-i18n-aria="howItWorks"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.5"/><circle cx="12" cy="7.6" r="0.6" fill="currentColor"/></svg>
          <span class="intro-info-label" data-i18n="howItWorks">{en.howItWorks}</span>
        </button>
      </div>

      <p class="lead" data-i18n="lead">{en.lead}</p>

      <!-- Tablets and phones: one field for all three choices, opening the controls
           below in a menu (src/scripts/forms-menu.js). -->
      <div class="control forms-entry">
        <span class="control-label" data-i18n="cvOptions">{en.cvOptions}</span>
        <button
          id="formsTrigger"
          class="menu-trigger forms-trigger"
          type="button"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="formsMenu"
          data-tip="cvOptions"
        >
          <span class="trigger-dot" aria-hidden="true"></span>
          <span id="formsSummary" class="forms-summary">Purple · Digital · English</span>
          <svg class="forms-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>
        </button>
      </div>

      <div id="cvControls" class="controls">
        <div class="control">
          <span class="control-label" data-i18n="accent">{en.accent}</span>

          <button
            id="colourTrigger"
            data-tip="accent"
            class="menu-trigger"
            type="button"
            aria-haspopup="dialog"
            aria-expanded="false"
          >
            <span class="trigger-dot" aria-hidden="true"></span>
            <span id="colourTriggerLabel">Purple</span>
            <span class="trigger-caret" aria-hidden="true">▾</span>
          </button>
        </div>

        <div class="control">
          <span class="control-label" data-i18n="edition">{en.edition}</span>
          <Segmented
            id="variantToggle"
            label={en.edition}
            labelI18n="edition"
            options={["digital", "print"].map((variant, index) => ({
              label: en[variant],
              i18n: variant,
              tip: variant,
              checked: index === 0,
              data: { variant },
            }))}
          />
        </div>

        <div class="control">
          <span class="control-label" data-i18n="cvLanguage">{en.cvLanguage}</span>
          <Segmented
            id="languageToggle"
            label={en.cvLanguage}
            labelI18n="cvLanguage"
            options={[
              { label: "EN", tip: "cvEn", checked: true, data: { language: "en" } },
              { label: "فا", tip: "cvFa", lang: "fa", data: { language: "fa" } },
            ]}
          />
        </div>

        <!-- Back to purple, digital, English: level with the controls it resets. -->
        <div class="control control-reset">
          <button id="resetCv" class="reset-control" type="button" data-tip="resetCv" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3"/><path d="M4.5 4.5v4h4"/></svg>
            <span data-i18n="reset">{en.reset}</span>
          </button>
        </div>
      </div>

      <ActionBar />

    </div>

    <PreviewPane />
  </section>

  <!-- Tablets and phones: the controls are moved in here. It comes before
       the colour menu, which opens on top of it. Reset is the icon in its
       header, like the accessibility menu's. -->
  <div id="formsMenu" class="menu forms-menu" slot="overlays" role="dialog" aria-labelledby="formsTitle" hidden>
    <div class="forms-head">
      <p id="formsTitle" class="forms-title" data-i18n="cvOptions">{en.cvOptions}</p>
      <button id="resetCvTop" class="reset-icon reset-top" type="button" data-tip="resetCv" aria-label={en.reset} data-i18n-aria="reset" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3"/><path d="M4.5 4.5v4h4"/></svg>
      </button>
    </div>
    <div class="forms-body"></div>
  </div>

  <div id="introPop" class="menu intro-pop" slot="overlays" role="dialog" aria-labelledby="introTitle" hidden>
    <p id="introTitle" class="intro-title" data-i18n="howItWorks">{en.howItWorks}</p>
    <p class="intro-text">
      <span class="lead-desktop-info" data-i18n="leadDesktopInfo">{en.leadDesktopInfo}</span>
      <span class="lead-tablet" data-i18n="leadTablet">{en.leadTablet}</span>
      <span class="lead-phone" data-i18n="leadPhone">{en.leadPhone}</span>
    </p>

    <!-- The tour: all of it, or one part, highlighted on the page
         (src/scripts/tour.js). -->
    <button id="tourStart" class="tour-start" type="button">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3.5"/></svg>
      <span data-i18n="tourStart">{en.tourStart}</span>
    </button>
    <p class="tour-topics-label" data-i18n="tourTopics">{en.tourTopics}</p>
    <!-- Filled by tour.js with the parts of the layout on screen. -->
    <div class="tour-topics"></div>
  </div>

  <div id="tour" class="tour" slot="overlays" hidden>
    <div class="tour-spot" aria-hidden="true"></div>
    <div class="tour-card" role="dialog" aria-modal="true" aria-labelledby="tourTitle" aria-describedby="tourText">
      <div class="tour-head">
        <span id="tourStep" class="tour-step"></span>
        <button id="tourClose" class="reset-icon tour-close" type="button" aria-label={en.tourClose} data-i18n-aria="tourClose">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <div aria-live="polite">
        <p id="tourTitle" class="tour-title"></p>
        <p id="tourText" class="tour-text"></p>
      </div>
      <div class="tour-nav">
        <button id="tourBack" class="tour-button" type="button" data-i18n="tourBack">{en.tourBack}</button>
        <button id="tourNext" class="tour-button is-primary" type="button" data-i18n="tourNext">{en.tourNext}</button>
      </div>
    </div>
  </div>

  <ColourMenu slot="overlays" />
</Base>

<script>
  import { initBuilder } from "../scripts/builder";
  import { initFormsMenu } from "../scripts/forms-menu";
  import { initMorph } from "../scripts/morph";
  import { initIntroInfo } from "../scripts/intro-info";

  initBuilder();
  initFormsMenu();
  initMorph();
  initIntroInfo();
</script>
