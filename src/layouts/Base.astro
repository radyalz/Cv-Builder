---
import { ClientRouter } from "astro:transitions";
import PrefsBoot from "./head/PrefsBoot.astro";
import AppHead from "./head/AppHead.astro";
import SkullField from "../components/SkullField.astro";
import A11yMenu from "../components/a11y/A11yMenu.astro";
import Tooltip from "../components/Tooltip.astro";
import "../styles/main.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <AppHead />
    <PrefsBoot />
    <ClientRouter />
  </head>

  <body>
    <div class="tone-field" aria-hidden="true" transition:persist="tone"><canvas></canvas></div>
    <SkullField transition:persist />

    <main class="page-shell">
      <slot />
    </main>

    <A11yMenu />
    <slot name="overlays" />
    <Tooltip />

    <script>
      import { initPrefs, t } from "../lib/prefs";
      import { initTooltip, showTouchHint } from "../lib/tooltip";
      import { initRipple } from "../lib/ripple";
      import { initSkulls } from "../lib/skulls";
      import { initHalftone } from "../lib/halftone";
      import { initWallpaper } from "../scripts/wallpaper";
      import { initInstall } from "../scripts/install";

      initPrefs();
      initHalftone();
      initSkulls();
      initWallpaper();
      initInstall(import.meta.env.PROD);
      initTooltip();
      initRipple();
      showTouchHint(t("touchHint"));
    </script>
  </body>
</html>
