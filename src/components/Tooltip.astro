---
// The single floating tooltip, driven by src/lib/tooltip.js for every
// element with data-tip.
---

<div id="tooltip" class="tooltip" role="tooltip">
  <div class="tip-pop">
    <div class="tip-bubble">
      <span class="tip-arrow" aria-hidden="true"></span>
      <div class="tip-content"></div>
    </div>
  </div>
</div>
