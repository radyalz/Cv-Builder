---
import { STRINGS } from "../lib/data";

const { en, fa } = STRINGS;
const icon = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}icons/icon-192.png`;
---

<div id="splash" class="splash" aria-hidden="true">
  <div class="splash-mark">
    <svg class="splash-ring" viewBox="0 0 100 100">
      <circle class="splash-track" cx="50" cy="50" r="46" />
      <circle class="splash-fill" cx="50" cy="50" r="46" pathLength="100" />
    </svg>
    <img class="splash-face" src={icon} alt="" width="76" height="76" />
  </div>
  <p class="splash-name"><span class="only-en">{en.name}</span><span class="only-fa" lang="fa">{fa.name}</span></p>
  <p class="splash-step"><span class="only-en">{en.splashFonts}</span><span class="only-fa" lang="fa">{fa.splashFonts}</span></p>
</div>
