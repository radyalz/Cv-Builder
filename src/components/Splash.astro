---
import { STRINGS } from "../lib/data";

const { en, fa } = STRINGS;
---

<div id="splash" class="splash" aria-hidden="true">
  <div class="splash-stage">
    <canvas class="splash-canvas"></canvas>
    <p class="splash-name"><span class="only-en">{en.name}</span><span class="only-fa" lang="fa">{fa.name}</span></p>
    <p class="splash-step"><span class="only-en">{en.splashFonts}</span><span class="only-fa" lang="fa">{fa.splashFonts}</span></p>
  </div>
  <div class="splash-wipe"><span><svg class="bolt" viewBox="0 0 40 100" preserveAspectRatio="none" aria-hidden="true"><polyline points="20,0 6,14 26,22 8,38 30,47 12,62 28,70 4,86 22,100" /></svg></span><span><svg class="bolt" viewBox="0 0 40 100" preserveAspectRatio="none" aria-hidden="true"><polyline points="22,0 30,12 10,24 28,33 6,49 24,58 14,72 32,84 18,100" /></svg></span><span><svg class="bolt" viewBox="0 0 40 100" preserveAspectRatio="none" aria-hidden="true"><polyline points="18,0 8,10 28,26 14,36 32,52 10,64 26,78 6,90 20,100" /></svg></span></div>
</div>
