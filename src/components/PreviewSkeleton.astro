---
// A CV-shaped placeholder that shimmers until the PDF has loaded: the
// header, then a paragraph section, a label/value section and a section of
// dated entries, like the real first page.
const repeat = (count: number) => Array.from({ length: count }, (_, index) => index);
---

<div id="previewSkeleton" class="preview-skeleton" aria-hidden="true">
  <div class="sk-header">
    <div class="sk-identity">
      <span class="sk sk-name"></span>
      <span class="sk sk-role"></span>
    </div>
    <div class="sk-contacts">
      {repeat(6).map(() => (
        <div class="sk-contact"><span class="sk sk-icon"></span><span class="sk sk-contact-text"></span></div>
      ))}
    </div>
  </div>

  <div class="sk-section">
    <div class="sk-section-head"><span class="sk sk-rule"></span><span class="sk sk-heading"></span></div>
    <div class="sk-body">
      {repeat(4).map(() => <span class="sk sk-line"></span>)}
      <span class="sk sk-line sk-short"></span>
    </div>
  </div>

  <div class="sk-section">
    <div class="sk-section-head"><span class="sk sk-rule"></span><span class="sk sk-heading"></span></div>
    <div class="sk-body">
      {repeat(5).map(() => (
        <div class="sk-row"><span class="sk sk-label"></span><span class="sk sk-value"></span></div>
      ))}
    </div>
  </div>

  <div class="sk-section">
    <div class="sk-section-head"><span class="sk sk-rule"></span><span class="sk sk-heading"></span></div>
    <div class="sk-body">
      {repeat(2).map(() => (
        <div class="sk-entry">
          <div class="sk-dates"><span class="sk sk-date"></span><span class="sk sk-duration"></span></div>
          <div class="sk-body">
            <span class="sk sk-title"></span>
            {repeat(2).map(() => (
              <div class="sk-bullet"><span class="sk sk-dot"></span><span class="sk sk-line"></span></div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
