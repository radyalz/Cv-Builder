---
// The published-copy preview beside the controls (drawn by
// src/lib/pdf-view.js), and the bar it gains when the card grows to fill
// the window (see "Expanding the preview" in
// src/scripts/builder.js).
import PreviewSkeleton from "./PreviewSkeleton.astro";
import BuildStatus from "./BuildStatus.astro";
import { STRINGS } from "../lib/data.js";

const en = STRINGS.en;
---

<aside class="card-preview" aria-labelledby="previewHeading">
  <div class="preview-head">
    <span id="previewHeading" class="control-label" data-i18n="preview">{en.preview}</span>
    <span id="previewLabel" class="preview-title">Purple</span>
  </div>

  <div class="preview-frame" tabindex="-1">
    <div
      id="previewDoc"
      class="pdf-view is-loading"
      role="document"
      aria-label={en.previewFrame}
      data-i18n-aria="previewFrame"
      hidden
    ></div>

    <PreviewSkeleton />

    <div id="previewState" class="preview-state" hidden></div>

    <!-- Shown when the copy (or the list of copies) cannot be fetched. -->
    <div id="previewError" class="preview-error" role="alert" hidden>
      <p class="preview-error-text"></p>
      <button id="previewRetry" class="ghost-button retry-button" type="button" data-tip="retry">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3"/><path d="M4.5 4.5v4h4"/></svg>
        <span data-i18n="retry">{en.retry}</span>
      </button>
    </div>

    <!-- A build's progress, shown on the preview itself. -->
    <div class="build-status">
      <BuildStatus />
    </div>

    <!-- Phones: the preview is a peek that opens when tapped. -->
    <span class="peek-hint" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h5v5M9 20H4v-5M20 4l-6.5 6.5M4 20l6.5-6.5"/></svg>
      <span data-i18n="tapExpand">{en.tapExpand}</span>
    </span>
  </div>

  <div class="preview-foot">
    <span id="previewMeta" class="preview-meta is-loading"></span>

    <!-- The PDF's links work in the preview; this says so, and lights them. -->
    <button class="links-hint" type="button" data-tip="linksHint" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1.1 1.1"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1.1-1.1"/></svg>
      <span class="links-hint-text"></span>
    </button>

    <button id="previewExpand" class="ghost-button" type="button" hidden data-i18n="expand" data-tip="expand">{en.expand}</button>
  </div>

  <!-- Shown once the card has grown to fill the window. -->
  <div class="expanded-bar">
    <!-- The copy's title pill. Under 400px it keeps only the coloured
         title, and the caret opens the rest (publish date, links) below. -->
    <div class="expanded-top">
      <div class="expanded-info">
        <span id="expandedLabel" class="preview-title"></span>
        <span id="expandedMeta" class="preview-meta"></span>
        <button id="infoToggle" class="info-toggle" type="button" aria-expanded="false" aria-controls="infoDetails" aria-label={en.copyDetails} data-i18n-aria="copyDetails">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5"/></svg>
        </button>
      </div>

      <div id="infoDetails" class="info-details">
        <span id="detailsMeta"></span>
        <span id="detailsLinks"></span>
      </div>
    </div>

    <!-- The tools pill, at the bottom: icons only on phones, where under
         350px the two fit buttons become one picker. -->
    <div class="expanded-actions">
      <button class="links-hint" type="button" data-tip="linksHint" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1.1 1.1"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1.1-1.1"/></svg>
        <span class="links-hint-text"></span>
      </button>

      <div class="pdf-tools" role="toolbar" aria-label={en.pdfTools} data-i18n-aria="pdfTools">
        <button class="icon-button" type="button" data-pdf="fit-width" data-tip="fitWidth" aria-label={en.fitWidth} data-i18n-aria="fitWidth">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7v10M20 7v10M8 12h8M8 12l2.5-2.5M8 12l2.5 2.5M16 12l-2.5-2.5M16 12l-2.5 2.5"/></svg>
        </button>
        <button class="icon-button" type="button" data-pdf="fit-page" data-tip="fitPage" aria-label={en.fitPage} data-i18n-aria="fitPage">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="3.5" width="12" height="17" rx="1.5"/><path d="M9 8h6M9 11.5h6M9 15h4"/></svg>
        </button>
        <div class="fit-select">
          <button id="fitSelect" class="icon-button fit-select-button" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="fitMenu" aria-label={en.pdfTools} data-i18n-aria="pdfTools" data-fit="width">
            <svg data-icon="width" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7v10M20 7v10M8 12h8M8 12l2.5-2.5M8 12l2.5 2.5M16 12l-2.5-2.5M16 12l-2.5 2.5"/></svg>
            <svg data-icon="page" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="3.5" width="12" height="17" rx="1.5"/><path d="M9 8h6M9 11.5h6M9 15h4"/></svg>
            <svg class="fit-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 14l5-5 5 5"/></svg>
          </button>
          <div id="fitMenu" class="fit-menu" role="menu" aria-label={en.pdfTools} data-i18n-aria="pdfTools">
            <button type="button" role="menuitemradio" aria-checked="true" data-pdf="fit-width">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7v10M20 7v10M8 12h8M8 12l2.5-2.5M8 12l2.5 2.5M16 12l-2.5-2.5M16 12l-2.5 2.5"/></svg>
              <span data-i18n="fitWidth">{en.fitWidth}</span>
            </button>
            <button type="button" role="menuitemradio" aria-checked="false" data-pdf="fit-page">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="3.5" width="12" height="17" rx="1.5"/><path d="M9 8h6M9 11.5h6M9 15h4"/></svg>
              <span data-i18n="fitPage">{en.fitPage}</span>
            </button>
          </div>
        </div>
        <span class="pdf-tools-rule" aria-hidden="true"></span>
        <button class="icon-button" type="button" data-pdf="zoom-out" data-tip="zoomOut" aria-label={en.zoomOut} data-i18n-aria="zoomOut">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12"/></svg>
        </button>
        <span id="pdfZoom" class="pdf-zoom" aria-live="polite">100%</span>
        <button class="icon-button" type="button" data-pdf="zoom-in" data-tip="zoomIn" aria-label={en.zoomIn} data-i18n-aria="zoomIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12M12 6v12"/></svg>
        </button>
      </div>

      <button id="expandedDownload" class="ghost-button bar-button" type="button" data-tip="download" aria-label={en.downloadShort} data-i18n-aria="downloadShort" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10.5l5 5 5-5M5 19.5h14"/></svg>
        <span data-i18n="downloadShort">{en.downloadShort}</span>
      </button>

      <button id="previewCollapse" class="ghost-button bar-button" type="button" data-tip="close" aria-label={en.close} data-i18n-aria="close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        <span data-i18n="close">{en.close}</span>
      </button>
    </div>
  </div>
</aside>
