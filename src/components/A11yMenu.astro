---
// The floating accessibility button and its menu: page language,
// appearance, text size and fonts. Behaviour is in src/lib/prefs.js.
import Segmented from "./Segmented.astro";
import { EN_FONTS, FA_FONTS, STRINGS, TEXT_SIZES } from "../lib/data";

const en = STRINGS.en;
const SIZE_KEYS = ["sizeSmall", "sizeDefault", "sizeLarge", "sizeLarger"];

// The Persian option labels are the font names written in Persian.
const FA_LABELS = { yekan: "یکان بخ", vazir: "وزیر", doran: "دوران", niloofar: "نیلوفر" };
const EN_LABELS = { jakarta: "Jakarta", plex: "Plex Sans", grotesk: "Grotesk" };
---

<button
  id="a11yTrigger"
  class="a11y-trigger"
  type="button"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-label={en.a11y}
  data-i18n-aria="a11y"
  data-tip="a11y"
><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.6"/><circle cx="12" cy="7.1" r="1.35" fill="currentColor" stroke="none"/><path d="M7.4 9.9c1.5.45 3 .66 4.6.66s3.1-.21 4.6-.66"/><path d="M12 10.6v3.3"/><path d="M9.7 17.6l2.3-3.7 2.3 3.7"/></svg></button>

<!-- Hides the card to show just the background; on phones it sits above
     the accessibility button, elsewhere beside it. -->
<button
  id="admireToggle"
  class="admire-toggle"
  type="button"
  aria-pressed="false"
  aria-label={en.admire}
  data-i18n-aria="admire"
  data-tip="admire"
><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6.5 9.5-6.5S21.5 12 21.5 12s-3.5 6.5-9.5 6.5S2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/></svg></button>

<!-- While admiring: save the background alone as an image or a video
     wallpaper (src/scripts/wallpaper.js). Beside the eye, above it on
     phones. -->
<button
  id="wallpaperToggle"
  class="admire-toggle wallpaper-toggle"
  type="button"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="wallpaperMenu"
  aria-label={en.saveBackground}
  data-i18n-aria="saveBackground"
  data-tip="saveBackground"
><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10.5l5 5 5-5M5 19.5h14"/></svg><span class="wallpaper-progress" aria-hidden="true"></span></button>

<div id="wallpaperMenu" class="menu wallpaper-menu" role="dialog" aria-labelledby="wallpaperTitle" hidden>
  <p id="wallpaperTitle" class="wallpaper-title" data-i18n="saveBackground">{en.saveBackground}</p>
  <p class="wallpaper-note" data-i18n="saveBackgroundNote">{en.saveBackgroundNote}</p>

  <button id="wallpaperImage" class="wallpaper-action" type="button">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="M20.5 16l-5-5-8 8"/></svg>
    <span class="wallpaper-action-text">
      <span data-i18n="saveImage">{en.saveImage}</span>
      <span class="wallpaper-size"></span>
    </span>
  </button>

  <div class="wallpaper-video">
    <span class="control-label" data-i18n="videoLength">{en.videoLength}</span>
    <Segmented
      id="wallpaperLength"
      label={en.videoLength}
      labelI18n="videoLength"
      group="wallpaper-length"
      options={[15, 20, 25, 30].map((seconds) => ({
        label: `${seconds}s`,
        checked: seconds === 15,
        data: { seconds },
      }))}
    />
    <button id="wallpaperVideo" class="wallpaper-action is-primary" type="button">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="13" height="12" rx="2"/><path d="M16 10.5l5-3v9l-5-3"/></svg>
      <span data-i18n="recordVideo">{en.recordVideo}</span>
    </button>
  </div>

  <!-- Shown while recording. -->
  <div class="wallpaper-recording" hidden>
    <div class="wallpaper-bar"><span></span></div>
    <p class="wallpaper-status" aria-live="polite"></p>
    <button id="wallpaperCancel" class="wallpaper-action" type="button" data-i18n="cancel">{en.cancel}</button>
  </div>
</div>

<!-- The install offer, rising in the bottom-left corner a few seconds
     after the page opens where the site can be installed, for 30 seconds
     (src/scripts/install.js). -->
<div id="installOffer" class="install-offer" role="dialog" aria-labelledby="installOfferTitle" aria-describedby="installOfferText" hidden>
  <img class="install-offer-icon" src={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}icons/icon-192.png`} alt="" width="48" height="48" />
  <div class="install-offer-body">
    <p id="installOfferTitle" class="install-offer-title" data-i18n="installTitle">{en.installTitle}</p>
    <p id="installOfferText" class="install-offer-text" data-i18n="installPitch">{en.installPitch}</p>
    <button id="installOfferButton" class="install-offer-button" type="button">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M12 7v7M9 11.5l3 3 3-3"/></svg>
      <span data-i18n="installNow">{en.installNow}</span>
    </button>
  </div>
  <button id="installOfferClose" class="reset-icon install-offer-close" type="button" aria-label={en.close} data-i18n-aria="close">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <span class="install-offer-time" aria-hidden="true"></span>
</div>

<div id="a11yMenu" class="menu a11y-menu" role="dialog" aria-labelledby="a11yTitle" hidden>
  <div class="a11y-head">
    <p id="a11yTitle" class="a11y-title" data-i18n="a11y">{en.a11y}</p>

    <button id="resetPrefs" class="reset-icon" type="button" data-tip="resetPrefs" aria-label={en.resetPrefs} data-i18n-aria="resetPrefs">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3"/><path d="M4.5 4.5v4h4"/></svg>
    </button>
  </div>

  <div class="a11y-group">
    <span class="control-label" data-i18n="pageLanguage">{en.pageLanguage}</span>
    <Segmented
      group="ui-lang"
      options={[
        { label: "English", tip: "uiEn", data: { "ui-lang": "en" } },
        { label: "فارسی", tip: "uiFa", lang: "fa", data: { "ui-lang": "fa" } },
      ]}
    />
  </div>

  <div class="a11y-group">
    <span class="control-label" data-i18n="appearance">{en.appearance}</span>
    <Segmented
      group="theme"
      options={["dark", "light"].map((theme) => ({
        label: en[theme],
        i18n: theme,
        tip: theme,
        data: { theme },
      }))}
    />
  </div>

  <div class="a11y-group">
    <span class="control-label" data-i18n="textSize">{en.textSize}</span>
    <Segmented
      group="fs"
      options={TEXT_SIZES.map((fs, index) => ({
        label: "A",
        ariaLabel: en[SIZE_KEYS[index]],
        ariaI18n: SIZE_KEYS[index],
        tip: `${SIZE_KEYS[index]}`,
        data: { fs },
      }))}
    />
  </div>

  <!-- Only the fonts for the page's current language are offered. -->
  <div class="a11y-group" data-font-lang="en">
    <span class="control-label" data-i18n="font">{en.font}</span>
    <div class="font-grid" role="radiogroup" data-a11y="en-font">
      {Object.entries(EN_FONTS).map(([slug, font]) => (
        <button class="font-option" type="button" role="radio" data-en-font={slug} data-tip="font" aria-checked="false">
          {EN_LABELS[slug] ?? font.name}
        </button>
      ))}
    </div>
  </div>

  <div class="a11y-group" data-font-lang="fa" hidden>
    <span class="control-label" data-i18n="font">{en.font}</span>
    <div class="font-grid" role="radiogroup" data-a11y="fa-font">
      {Object.keys(FA_FONTS).map((slug) => (
        <button class="font-option" type="button" role="radio" data-fa-font={slug} data-tip="font" lang="fa" aria-checked="false">
          {FA_LABELS[slug]}
        </button>
      ))}
    </div>
  </div>

  <button id="admireFromMenu" class="ghost-button admire-menu-button" type="button" aria-pressed="false" data-tip="admire">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6.5 9.5-6.5S21.5 12 21.5 12s-3.5 6.5-9.5 6.5S2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/></svg>
    <span data-i18n="admire">{en.admire}</span>
  </button>

  <!-- Shown only where the site can be installed and is not already
       (src/scripts/install.js). iPhones and iPads have no install prompt,
       so there it shows the steps instead. -->
  <button id="installApp" class="ghost-button admire-menu-button install-button" type="button" data-tip="installApp" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M12 7v7M9 11.5l3 3 3-3"/></svg>
    <span data-i18n="installApp">{en.installApp}</span>
  </button>
  <p id="installSteps" class="install-steps" data-i18n="installIos" hidden>{en.installIos}</p>

  <!-- When the site is installed. A page cannot remove an installed app
       itself, so this shows how on this device, and can delete the offline
       copy (src/scripts/install.js). -->
  <button id="uninstallApp" class="ghost-button admire-menu-button install-button" type="button" data-tip="uninstallApp" aria-expanded="false" aria-controls="uninstallPanel" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M9.5 9.5l5 5M14.5 9.5l-5 5"/></svg>
    <span data-i18n="uninstallApp">{en.uninstallApp}</span>
  </button>
  <div id="uninstallPanel" class="uninstall-panel" hidden>
    <p class="install-steps uninstall-how"></p>
    <p class="install-steps" data-i18n="uninstallNote">{en.uninstallNote}</p>
    <button id="clearOffline" class="ghost-button admire-menu-button install-button" type="button">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4.5h6V7M6.5 7l1 13h9l1-13"/></svg>
      <span data-i18n="clearOffline">{en.clearOffline}</span>
    </button>
    <p class="install-steps offline-status" aria-live="polite"></p>
  </div>
</div>
